# URL base da API do backend Spring Boot
VITE_API_BASE_URL=http://localhost:8081

# Flag para uso de dados simulados (true) ou chamadas à API real (false)
# Padrão: true (preserva o funcionamento das telas até que os adapters reais sejam concluídos)
VITE_USE_MOCKS=true

# Limites de upload no navegador (validação de UX)
VITE_MAX_PDF_MB=50
VITE_MAX_VIDEO_MB=500
