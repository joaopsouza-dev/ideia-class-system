# ============================================================================
# Modelo do arquivo de ambiente do backend Ideia Space.
#
# 1. Copie este arquivo:      cp .env.example .env
# 2. Substitua TODOS os valores que começam com "troque" (ou estão vazios).
# 3. Nunca versione o arquivo .env real (ele já está no .gitignore).
#
# Gerar segredos fortes:      openssl rand -hex 32
# A aplicação RECUSA iniciar se APP_JWT_SECRET, APP_CPF_KEY ou APP_CPF_HMAC_KEY
# estiverem vazios, tiverem menos de 32 caracteres ou contiverem "troque".
# ============================================================================

# Superusuário do PostgreSQL (também usado pelo Flyway para migrations).
POSTGRES_PASSWORD=troque_por_senha_forte_do_postgres

# Senha da role de runtime app_backend (usada pelo backend).
APP_BACKEND_DB_PASSWORD=troque_por_senha_forte_do_app_backend

# Assinatura dos tokens JWT. Gere com: openssl rand -hex 32
APP_JWT_SECRET=troque_por_segredo_hex_de_64_caracteres
APP_TOKEN_TTL_MINUTES=60

# Chaves de CPF. Gere cada uma com: openssl rand -hex 32
APP_CPF_KEY=troque_por_chave_hex_de_64_caracteres
APP_CPF_HMAC_KEY=troque_por_chave_hex_de_64_caracteres

# Origens permitidas pelo CORS, separadas por vírgula.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Primeiro administrador (bootstrap). Preencha apenas para criar o primeiro ADMIN.
# A senha deve ter no mínimo 12 caracteres. Depois do primeiro ADMIN existir,
# deixe estas variáveis vazias ou remova-as.
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
