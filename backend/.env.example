# ============================================================================
# Modelo do arquivo de ambiente do backend Ideia Space.
#
# 1. Copie este arquivo:      cp .env.example .env
# 2. Substitua TODOS os valores que começam com "troque" (ou estão vazios).
# 3. Nunca versione o arquivo .env real (ele já está no .gitignore).
#
# Gerar segredos fortes:      openssl rand -hex 32
# A aplicação RECUSA iniciar se APP_JWT_SECRET, APP_CPF_KEY ou APP_CPF_HMAC_KEY
# estiverem vazios, tiverem menos de 32 caracteres ou contiverem "troque".
# ============================================================================

# Superusuário do PostgreSQL (também usado pelo Flyway para migrations).
POSTGRES_PASSWORD=troque_por_senha_forte_do_postgres

# Senha da role de runtime app_backend (usada pelo backend).
APP_BACKEND_DB_PASSWORD=troque_por_senha_forte_do_app_backend

# Assinatura dos tokens JWT. Gere com: openssl rand -hex 32
APP_JWT_SECRET=troque_por_segredo_hex_de_64_caracteres
APP_TOKEN_TTL_MINUTES=60

# Chaves de CPF. Gere cada uma com: openssl rand -hex 32
APP_CPF_KEY=troque_por_chave_hex_de_64_caracteres
APP_CPF_HMAC_KEY=troque_por_chave_hex_de_64_caracteres

# Origens permitidas pelo CORS, separadas por vírgula.
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload de materiais (Etapa 3). Todos opcionais; os valores abaixo são os padrões.
# Os arquivos ficam no volume Docker "ideiaspace_uploads_data" (montado em /app/storage),
# fora do PostgreSQL e sem URL pública. Em execução local (sem Docker) use APP_STORAGE_ROOT
# para escolher a pasta; o padrão é ./data/storage.
# APP_STORAGE_ROOT=./data/storage
APP_UPLOAD_MAX_PDF_MB=50
APP_UPLOAD_MAX_VIDEO_MB=500
# Limite da requisição multipart inteira; deve ser maior que APP_UPLOAD_MAX_VIDEO_MB.
APP_UPLOAD_MAX_REQUEST_MB=512

# Primeiro administrador (bootstrap). Preencha apenas para criar o primeiro ADMIN.
# A senha deve ter no mínimo 12 caracteres. Depois do primeiro ADMIN existir,
# deixe estas variáveis vazias ou remova-as.
APP_BOOTSTRAP_ADMIN_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Armazenamento dos arquivos (PDF/vídeo)
# ----------------------------------------------------------------------------
# "local"    -> volume Docker (padrão; demonstração e testes). URLs temporárias assinadas
#               pelo próprio backend. NÃO é o Firebase.
# "firebase" -> Cloud Storage for Firebase (bucket privado; Signed URLs V4).
# Veja docs/FIREBASE_SETUP.md antes de ativar o provedor "firebase".
APP_STORAGE_PROVIDER=local

# Validade da URL temporária de leitura, em segundos (mínimo 30, máximo 3600).
APP_STORAGE_SIGNED_URL_TTL_SECONDS=900

# Somente com APP_STORAGE_PROVIDER=firebase (valores abaixo são ILUSTRATIVOS):
# FIREBASE_PROJECT_ID=id-do-projeto-no-firebase
# FIREBASE_STORAGE_BUCKET=nome-exato-do-bucket-no-console
# Caminho LOCAL do JSON da conta de serviço (usado pelo docker compose para montar o arquivo
# como somente-leitura). Fora do Docker, exporte GOOGLE_APPLICATION_CREDENTIALS com esse caminho.
# FIREBASE_CREDENTIALS_FILE=/caminho/seguro/fora-do-repositorio/credencial.json
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/fora-do-repositorio/credencial.json
